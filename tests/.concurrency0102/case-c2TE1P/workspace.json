{"schemaVersion":1,"revision":4,"state":{"schemaVersion":1,"businessMigrationVersion":1,"tasks":[{"id":"TASK-IMPORT-20261112-1","name":"Synthetic concurrency","fileName":"synthetic-concurrency.xlsx","mode":"manual","scene":"新品产品咨询","scenarioSnapshot":{"schemaVersion":1,"id":"新品产品咨询","name":"新品产品咨询","version":1,"enabled":true,"builtin":true,"engine":"conversation","layout":"turns","inputProfileId":"","ruleIds":[],"analysisFields":["salesStage","intent","demandSummary","negativeVoice"],"customFields":[],"report":{"title":"新品质检报告","groupBy":"product","groupField":"","groupLabel":"产品","sections":["overview","breakdown","dimensions","cases","improvements","voc"]},"requiredCapabilities":["text-judgment"],"createdAt":"2026-11-05T00:00:00+08:00","updatedAt":"2026-11-05T00:00:00+08:00"},"aiStatus":"paused","progress":0,"status":"待审核","createdAt":"2026-11-12T10:00:00+08:00","source":{"sha256":"b85193d283b50821fab68be7b0b14cc96fd2c1e352136ef9c693f63fefd10f1f","name":"synthetic-concurrency.xlsx","size":2855,"createdAt":"2026-11-17T07:01:01.743Z"},"basisSnapshot":{"capturedAt":"2026-11-12T10:00:00+08:00","effectiveDate":"2026-11-12","rules":[{"expiresAt":"","changeNote":"初始化虚构演示版本","status":"已发布","createdAt":"2026-10-01T09:00:00+08:00","publishedAt":"2026-10-01T09:00:00+08:00","sceneIds":["新品产品咨询"],"ruleKind":"session-check","id":"R001","version":"V1.0","title":"产品参数准确","category":"产品信息","scope":"涉及产品参数或型号对比的售前会话","effectiveAt":"2026-10-01","owner":"演示规则维护人","passCriteria":"型号、内存、电池和充电等参数与对应产品说明一致。","failCriteria":"混淆型号或提供与产品说明不符的参数。","exceptionCriteria":"没有涉及产品参数时不适用；关键材料缺失时无法判定。","policyIds":["P001"],"name":"产品参数准确"},{"expiresAt":"","changeNote":"初始化虚构演示版本","status":"已发布","createdAt":"2026-10-01T09:00:00+08:00","publishedAt":"2026-10-01T09:00:00+08:00","sceneIds":["新品产品咨询"],"ruleKind":"session-check","id":"R004","version":"V1.0","title":"首次响应时间","category":"服务时效","scope":"全部售前会话","effectiveAt":"2026-10-01","owner":"演示规则维护人","passCriteria":"使用客观可核对的描述。","failCriteria":"使用绝对第一、永远不卡等无法证实的绝对化承诺。","exceptionCriteria":"信息缺失导致无法核对时使用无法判定。","policyIds":["P004"],"name":"首次响应时间"}],"policies":[{"expiresAt":"","changeNote":"初始化虚构演示版本","status":"已发布","createdAt":"2026-10-01T09:00:00+08:00","publishedAt":"2026-10-01T09:00:00+08:00","sceneIds":["新品产品咨询"],"id":"P001","version":"V1.0","title":"星澜 A 系列产品参数说明（虚构）","category":"产品信息","scope":"星澜商城虚构售前服务","effectiveAt":"2026-10-01","owner":"演示资料维护人","source":"内置虚构演示资料","sections":[{"id":"P001-1","title":"星澜 A1 标准参数","text":"星澜 A1 售价2499元，12+256GB，5000mAh电池，支持66W有线充电，不支持无线充电。不得混用 Pro 版本参数。"},{"id":"P001-2","title":"星澜 A1 Pro 标准参数","text":"星澜 A1 Pro 售价3299元，12+512GB，5200mAh电池，支持88W有线充电及30W无线充电。"}],"content":"P001-1 星澜 A1 标准参数\n星澜 A1 售价2499元，12+256GB，5000mAh电池，支持66W有线充电，不支持无线充电。不得混用 Pro 版本参数。\n\nP001-2 星澜 A1 Pro 标准参数\n星澜 A1 Pro 售价3299元，12+512GB，5200mAh电池，支持88W有线充电及30W无线充电。"},{"expiresAt":"","changeNote":"初始化虚构演示版本","status":"已发布","createdAt":"2026-10-01T09:00:00+08:00","publishedAt":"2026-10-01T09:00:00+08:00","sceneIds":["新品产品咨询"],"id":"P004","version":"V1.0","title":"售前沟通与交易规范（虚构）","category":"沟通与服务","scope":"星澜商城虚构售前服务","effectiveAt":"2026-10-01","owner":"演示资料维护人","source":"内置虚构演示资料","sections":[{"id":"P004-1","title":"需求澄清与推荐","text":"推荐产品前，应了解客户已表达的预算、用途及必要功能；已明确的信息无需重复追问。推荐超出预算时应说明差额并征求接受度，不得忽略明确的必要条件。"},{"id":"P004-2","title":"客观沟通","text":"使用可核对的信息说明产品，不得使用永远不卡、绝对第一、100%不会坏等无法证明的绝对化或夸大承诺。"},{"id":"P004-3","title":"官方支付","text":"仅引导客户通过星澜商城官方订单支付。禁止要求私人转账、个人收款码付款，或以私下优惠引导绕开官方订单。"},{"id":"P004-4","title":"结束确认","text":"完成解答后，应确认客户问题是否已解决或是否还有其他疑问。会话仍在取证、等待客户材料时，不强行判断解答已经完成。"},{"id":"P004-5","title":"信息不足的处理","text":"截图或附件缺失、关键上下文不足时，应明确缺失信息并请求补充；审核者无法取得关键证据时使用无法判定，不得把缺失信息等同于违规。与会话无关的规则使用不适用。"}],"content":"P004-1 需求澄清与推荐\n推荐产品前，应了解客户已表达的预算、用途及必要功能；已明确的信息无需重复追问。推荐超出预算时应说明差额并征求接受度，不得忽略明确的必要条件。\n\nP004-2 客观沟通\n使用可核对的信息说明产品，不得使用永远不卡、绝对第一、100%不会坏等无法证明的绝对化或夸大承诺。\n\nP004-3 官方支付\n仅引导客户通过星澜商城官方订单支付。禁止要求私人转账、个人收款码付款，或以私下优惠引导绕开官方订单。\n\nP004-4 结束确认\n完成解答后，应确认客户问题是否已解决或是否还有其他疑问。会话仍在取证、等待客户材料时，不强行判断解答已经完成。\n\nP004-5 信息不足的处理\n截图或附件缺失、关键上下文不足时，应明确缺失信息并请求补充；审核者无法取得关键证据时使用无法判定，不得把缺失信息等同于违规。与会话无关的规则使用不适用。"}]},"sessionIds":["TASK-IMPORT-20261112-1-S1","TASK-IMPORT-20261112-1-S2","TASK-IMPORT-20261112-1-S3","TASK-IMPORT-20261112-1-S4"],"inputMode":"raw-transcript-v1","evidenceContractVersion":"raw-text-quote-v1","rawImportOptions":{"timePolicy":{"mode":"unavailable","timezone":"+08:00"},"productDefault":"","outputLanguage":"zh"},"executionSettings":{"concurrency":1,"batchSize":20,"maxWorkBytes":64000},"reviewPolicy":{"version":1,"enabled":true,"confidenceThreshold":0.9,"calibrationStatus":"unvalidated"},"aiQueue":{"version":1,"fingerprint":"7003939acbe0e93c3342d5e08e2e5d3924d0e51c47aaf7d6172eda071fb1f683","modelConfigFingerprint":"beaf8c7bce2b52f79589d55f65408038915a81c418c851e304181920bb6125ff","status":"paused","phase":"rows","settings":{"concurrency":1,"batchSize":20,"maxWorkBytes":64000},"batches":[{"id":"segment-1","index":1,"sessionIds":["TASK-IMPORT-20261112-1-S1","TASK-IMPORT-20261112-1-S2","TASK-IMPORT-20261112-1-S3","TASK-IMPORT-20261112-1-S4"],"status":"pending","workBytes":3828}],"rows":[{"sessionId":"TASK-IMPORT-20261112-1-S1","sourceRow":2,"batchId":"segment-1","status":"pending","attempts":0,"startedAt":null,"completedAt":null,"durationMs":0,"runId":"MIXED-FAIL","inputSha256":"f2c632685c7403cf1e1e87859c310fd16c939351fff7c2654a753ee98fb35ffb"},{"sessionId":"TASK-IMPORT-20261112-1-S2","sourceRow":3,"batchId":"segment-1","status":"pending","attempts":0,"startedAt":null,"completedAt":null,"durationMs":0,"runId":"MIXED-FAIL","inputSha256":"f9967539400837a7fabfa6b84a422dc8fc1e32b8556f86b3966fd5181b20432c"},{"sessionId":"TASK-IMPORT-20261112-1-S3","sourceRow":4,"batchId":"segment-1","status":"pending","attempts":0,"startedAt":null,"completedAt":null,"durationMs":0,"runId":"MIXED-FAIL","inputSha256":"41e363e0dd8e9a6ea7a315e01a9e892f75100fd262f435560e86cc1c52101606"},{"sessionId":"TASK-IMPORT-20261112-1-S4","sourceRow":5,"batchId":"segment-1","status":"pending","attempts":0,"started